<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">

  <!-- Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

<body class="grey lighten-4">

  <!-- Navbar -->
  <nav class="purple">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">
        <i class="material-icons left">sports_esports</i>
        GameApp
      </a>
    </div>
  </nav>

  <!-- Contenido -->
  <div class="container center-align" style="margin-top: 50px;">
    
    <h4>Bienvenido a la Página de Inicio</h4>

    <div class="row" style="margin-top: 40px;">

      <!-- Acerca de -->
      <div class="col s12 m3">
        <div class="card hoverable">
          <div class="card-content center-align">
            <i class="material-icons large purple-text">info</i>
            <h5>Acerca de</h5>
            <p>Información sobre la app</p>
          </div>
          <div class="card-action center-align">
            <a href="/about" class="btn purple">Ir</a>
          </div>
        </div>
      </div>

      <!-- Registrar juego -->
      <div class="col s12 m3">
        <div class="card hoverable">
          <div class="card-content center-align">
            <i class="material-icons large purple-text">add_circle</i>
            <h5>Registrar Juego</h5>
            <p>Agrega tu juego favorito</p>
          </div>
          <div class="card-action center-align">
            <a href="/games" class="btn purple">Ir</a>
          </div>
        </div>
      </div>

      <!-- Ver lista -->
      <div class="col s12 m3">
        <div class="card hoverable">
          <div class="card-content center-align">
            <i class="material-icons large purple-text">list</i>
            <h5>Ver Juegos</h5>
            <p>Lista de juegos registrados</p>
          </div>
          <div class="card-action center-align">
            <a href="/favGames" class="btn purple">Ir</a>
          </div>
        </div>
      </div>

      <!-- Contacto -->
      <div class="col s12 m3">
        <div class="card hoverable">
          <div class="card-content center-align">
            <i class="material-icons large purple-text">contact_mail</i>
            <h5>Contacto</h5>
            <p>Ponte en contacto</p>
          </div>
          <div class="card-action center-align">
            <a href="/contact" class="btn purple">Ir</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Materialize JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

</body>
</html>