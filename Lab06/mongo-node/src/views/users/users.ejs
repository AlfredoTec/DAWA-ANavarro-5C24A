<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - Users</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <%- include("../partials/navbar") %>

  <div class="container" style="margin-top: 24px;">
    <div class="row">
      <div class="col s12">
        <div class="card-panel white" style="border-radius: 14px;">
          <h4 style="margin-top: 0;">Users</h4>
          <p class="grey-text text-darken-1">Crea usuarios para poder asignarlos al crear posts.</p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col s12 m5">
        <div class="card" style="border-radius: 14px; overflow: hidden;">
          <div class="card-content">
            <span class="card-title" style="font-weight: 700;">Crear usuario</span>

            <form method="POST" action="/users">
              <div class="input-field">
                <input id="name" name="name" type="text" required>
                <label for="name">Nombre</label>
              </div>

              <div class="input-field">
                <input id="lastName" name="lastName" type="text">
                <label for="lastName">Apellido</label>
              </div>

              <div class="input-field">
                <input id="email" name="email" type="email" required>
                <label for="email">Email</label>
              </div>

              <div class="input-field">
                <input id="phoneNumber" name="phoneNumber" type="text">
                <label for="phoneNumber">Phone Number</label>
              </div>

              <div class="input-field">
                <input id="age" name="age" type="number" min="18" required>
                <label for="age">Age (min 18)</label>
              </div>

              <div class="input-field">
                <input id="password" name="password" type="password" minlength="8" required>
                <label for="password">Password (min 8)</label>
              </div>

              <button class="btn waves-effect waves-light blue darken-2" type="submit">
                <i class="material-icons left">person_add</i>
                Crear
              </button>
            </form>
          </div>
        </div>
      </div>

      <div class="col s12 m7">
        <div class="card" style="border-radius: 14px; overflow: hidden;">
          <div class="card-content">
            <span class="card-title" style="font-weight: 700;">Lista</span>

            <% if (!users || users.length === 0) { %>
              <div class="card-panel" style="border-radius: 14px;">
                <div class="valign-wrapper">
                  <i class="material-icons blue-text text-darken-2" style="margin-right: 10px;">info</i>
                  <span>No hay usuarios todavía.</span>
                </div>
              </div>
            <% } else { %>
              <ul class="collection">
                <% users.forEach((u) => { %>
                  <li class="collection-item">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <div>
                        <div style="font-weight: 700;"><%= u.name %> <%= u.lastName || "" %></div>
                        <div class="grey-text text-darken-1" style="font-size: 0.9rem;"><%= u.email %></div>
                      </div>
                      <div class="grey-text" style="font-size: 0.8rem;">ID: <%= u._id %></div>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col s12">
        <a class="btn waves-effect waves-light white black-text" href="/">
          <i class="material-icons left">arrow_back</i>
          Volver
        </a>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
